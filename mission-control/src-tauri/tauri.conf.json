{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Albert Mission Control",
  "version": "0.1.0",
  "identifier": "dev.albert.mission-control",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Albert Mission Control",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
